<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>双十一投标人服务产品促销活动方案</title>
<style>
:root{
  --red:#E1251B; --red2:#FF5A45; --redsoft:#FFF1EF;
  --orange:#FF8A00; --gold:#F5B301; --goldsoft:#FFF8E6;
  --ink:#16181D; --ink2:#4A5058; --ink3:#8A9099;
  --bg:#F4F5F7; --card:#FFFFFF; --line:#E8EAEE; --linesoft:#F1F2F5;
  --green:#0FA968; --bluesoft:#EEF4FF; --blue:#2B6CDB;
  --warnsoft:#FFF7E6; --warnline:#FFE2A8;
  --radius:14px;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;background:var(--bg);color:var(--ink);line-height:1.7;-webkit-font-smoothing:antialiased;font-size:15px;}
.wrap{max-width:1160px;margin:0 auto;padding:0 20px 100px;}

.nav{position:sticky;top:0;z-index:99;background:rgba(255,255,255,.93);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);}
.nav-in{max-width:1160px;margin:0 auto;padding:0 20px;display:flex;align-items:center;gap:4px;height:54px;overflow-x:auto;}
.nav-in::-webkit-scrollbar{display:none;}
.nav a{font-size:12.5px;color:var(--ink2);text-decoration:none;padding:6px 10px;border-radius:20px;white-space:nowrap;transition:.18s;}
.nav a:hover{background:var(--redsoft);color:var(--red);}
.nav-brand{font-weight:800;font-size:14px;color:var(--red);margin-right:8px;white-space:nowrap;}

.hero{background:linear-gradient(135deg,#C4140C 0%,#E1251B 42%,#FF6A3D 100%);color:#fff;padding:50px 0 58px;position:relative;overflow:hidden;}
.hero::after{content:"";position:absolute;right:-140px;top:-140px;width:460px;height:460px;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 68%);}
.hero::before{content:"";position:absolute;left:-90px;bottom:-160px;width:380px;height:380px;background:radial-gradient(circle,rgba(255,255,255,.10),transparent 70%);}
.hero-in{max-width:1160px;margin:0 auto;padding:0 20px;position:relative;z-index:2;}
.hero-tag{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.3);padding:5px 14px;border-radius:20px;font-size:12.5px;margin-bottom:16px;}
.hero-tag i{width:6px;height:6px;border-radius:50%;background:#FFD84D;display:block;}
.hero h1{font-size:40px;line-height:1.22;font-weight:800;letter-spacing:-.5px;}
.hero h1 em{font-style:normal;color:#FFE05C;}
.hero .sub{font-size:16px;opacity:.94;margin-top:12px;max-width:800px;}
.hero .sub b{font-weight:700;border-bottom:2px solid rgba(255,255,255,.5);padding-bottom:1px;}
.hero-meta{display:flex;flex-wrap:wrap;gap:22px;margin-top:22px;font-size:13px;opacity:.92;}
.hk{background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.24);border-radius:var(--radius);padding:15px 17px;}
.hk small{display:block;font-size:12px;opacity:.85;margin-bottom:3px;}
.hk strong{font-size:26px;font-weight:800;letter-spacing:-.5px;line-height:1.2;}
.hk strong i{font-style:normal;font-size:14px;font-weight:600;margin-left:2px;}
.hk p{font-size:11.5px;opacity:.78;margin-top:3px;}

section{margin-top:44px;}
.s-head{display:flex;align-items:flex-start;gap:13px;margin-bottom:18px;}
.s-no{flex:none;width:32px;height:32px;border-radius:9px;background:var(--red);color:#fff;font-size:15px;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(225,37,27,.28);}
.s-no.warn{background:var(--orange);box-shadow:0 4px 12px rgba(255,138,0,.28);}
.s-head h2{font-size:21px;font-weight:800;letter-spacing:-.3px;line-height:1.35;}
.s-head p{font-size:13px;color:var(--ink3);margin-top:3px;}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px 22px;}
.card+.card{margin-top:14px;}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
h3.ct{font-size:15px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
h3.ct::before{content:"";width:3px;height:15px;border-radius:2px;background:var(--red);display:block;}
h3.ct.gray::before{background:var(--ink3);}

table{width:100%;border-collapse:collapse;font-size:13px;}
th{background:#FAFBFC;font-weight:700;color:var(--ink2);text-align:left;padding:9px 11px;border-bottom:1px solid var(--line);font-size:12px;white-space:nowrap;}
td{padding:9px 11px;border-bottom:1px solid var(--linesoft);vertical-align:top;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover{background:#FCFCFD;}
tr.total-row td{background:var(--redsoft);font-weight:800;color:var(--red);border-bottom:none;}
tr.sub-row td{background:#FAFBFC;font-weight:700;color:var(--ink2);}
.num{font-variant-numeric:tabular-nums;font-weight:600;}
.tag{display:inline-block;font-size:11px;padding:1.5px 7px;border-radius:5px;font-weight:700;vertical-align:middle;white-space:nowrap;}
.t-red{background:var(--redsoft);color:var(--red);}
.t-gold{background:var(--goldsoft);color:#9A6B00;}
.t-blue{background:var(--bluesoft);color:var(--blue);}
.t-gray{background:#F2F3F5;color:var(--ink3);}
.t-green{background:#E9F8F1;color:var(--green);}
.t-warn{background:var(--warnsoft);color:#9A6B00;}
.muted{color:var(--ink3);font-size:12.5px;}

.funnel{display:flex;flex-direction:column;gap:8px;align-items:center;}
.fn{width:100%;border-radius:10px;padding:12px 18px;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px;}
.fn span{font-size:13px;font-weight:600;opacity:.95;}
.fn b{font-size:19px;font-weight:800;font-variant-numeric:tabular-nums;}
.f1{background:linear-gradient(90deg,#C4140C,#E1251B);}
.f2{background:linear-gradient(90deg,#E1251B,#F04A2E);}
.f3{background:linear-gradient(90deg,#F0562E,#FF7A33);}
.f4{background:linear-gradient(90deg,#FF8A00,#FFA733);}
.f5{background:linear-gradient(90deg,#F5B301,#FFC945);color:#4A3200;}
.f5 span{opacity:1;}
.arrowdown{text-align:center;color:var(--ink3);font-size:11px;line-height:1;}

.bars{display:flex;flex-direction:column;gap:10px;}
.bar-row{display:grid;grid-template-columns:180px 1fr 90px;gap:12px;align-items:center;font-size:13px;}
.bar-row .lb{color:var(--ink2);font-weight:600;}
.bar-track{height:20px;background:#F1F2F5;border-radius:6px;overflow:hidden;}
.bar-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,#E1251B,#FF7A33);}
.bar-row .vl{text-align:right;font-weight:700;font-variant-numeric:tabular-nums;font-size:13px;}

.tl-line{height:8px;border-radius:4px;background:linear-gradient(90deg,#E8EAEE,#FFC945 20%,#E1251B 41%,#E1251B 80%,#FF8A00);}
.tl-days{display:flex;font-size:11px;color:var(--ink3);margin-top:5px;}
.tl-days div{flex:1;text-align:center;}
.tl-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:16px;}
.tl-c{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 13px;position:relative;}
.tl-c.hot{border:2px solid var(--red);box-shadow:0 6px 20px rgba(225,37,27,.14);}
.tl-c.hot::before{content:"活动期";position:absolute;top:-9px;left:13px;background:var(--red);color:#fff;font-size:10.5px;font-weight:700;padding:1.5px 9px;border-radius:9px;}
.tl-c h4{font-size:13px;font-weight:800;margin-bottom:4px;}
.tl-c .dt{font-size:11px;color:var(--red);font-weight:700;margin-bottom:8px;font-variant-numeric:tabular-nums;}
.tl-c ul{list-style:none;font-size:12px;color:var(--ink2);line-height:1.72;}
.tl-c ul li::before{content:"·";color:var(--red);font-weight:900;margin-right:5px;}
td
td
td
td
td
td
td

.persona{border:1px solid var(--line);border-radius:12px;padding:15px 16px;background:#fff;display:flex;flex-direction:column;}
.persona .ph{display:flex;align-items:center;gap:9px;margin-bottom:9px;}
.persona .pico{width:32px;height:32px;border-radius:10px;background:var(--redsoft);color:var(--red);display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;flex:none;}
.persona h4{font-size:14px;font-weight:800;}
.persona .pn{font-size:11.5px;color:var(--ink3);}
.persona .pl{font-size:11.5px;font-weight:700;color:var(--ink3);margin:8px 0 3px;}
.persona p{font-size:12.5px;color:var(--ink2);line-height:1.7;}
.persona .ppill{display:inline-block;font-size:11.5px;background:#F5F6F8;color:var(--ink2);padding:2px 9px;border-radius:6px;margin:3px 4px 0 0;}
.persona .pm{margin-top:auto;padding-top:10px;border-top:1px dashed var(--line);font-size:12px;color:var(--ink2);}

.pil{background:#fff;border:1px solid var(--line);border-left:3px solid var(--red);border-radius:10px;padding:13px 14px;}
.pil h4{font-size:13px;font-weight:800;margin-bottom:5px;}
.pil p{font-size:12.5px;color:var(--ink2);line-height:1.7;}
.pil .kw{font-size:11.5px;color:var(--red);font-weight:700;margin-top:7px;display:block;}

.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.kpi{border:1px solid var(--line);border-radius:12px;padding:14px 15px;background:#fff;}
.kpi small{font-size:12px;color:var(--ink3);display:block;}
.kpi strong{font-size:22px;font-weight:800;color:var(--red);display:block;margin:4px 0 2px;letter-spacing:-.5px;}
.kpi span{font-size:11.5px;color:var(--ink3);}

.banlist{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;}
.banlist span{background:#fff;border:1px solid #FFD3CC;color:#C4140C;font-size:12px;padding:2px 9px;border-radius:6px;font-weight:600;}

.kv{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:13px;}
.kv dt{color:var(--ink3);font-size:12.5px;padding-top:2px;}
.kv dd{color:var(--ink);font-weight:600;}

.footer{text-align:center;font-size:12px;color:var(--ink3);margin-top:52px;padding-top:20px;border-top:1px solid var(--line);}
.src{font-size:11px;background:#F2F3F5;color:var(--ink3);padding:1px 6px;border-radius:4px;font-weight:600;}

@media(max-width:900px){
  .hero h1{font-size:29px;}
  .grid4,.grid3,.kpi-grid,.tl-cards{grid-template-columns:1fr 1fr;}
  .grid2{grid-template-columns:1fr;}
  .bar-row{grid-template-columns:120px 1fr 74px;}
}
@media(max-width:620px){
  .grid4,.grid3,.kpi-grid,.tl-cards{grid-template-columns:1fr;}
  .hero h1{font-size:24px;}
}
@media print{
  .nav{display:none;} body{background:#fff;} section{page-break-inside:avoid;}
  .hero{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
}
</style>
</head>
